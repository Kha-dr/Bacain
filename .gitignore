# ==============================================================================
# Git Ignore Rules for BacaIn (Firmware + Web + Python)
# ==============================================================================

# ESP-IDF Build & Output Directories
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/sdkconfig*
firmware/dependencies.lock
firmware/managed_components/
**/build/
**/sdkconfig
**/sdkconfig.old
**/dependencies.lock
**/managed_components/

# Python Cache & Virtual Environments
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Node.js & Web Dependencies
web/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Web Serial Flasher Binary Artifacts (preserve manifest.json and .gitkeep)
web/firmware/*.bin

# Language Server & Clangd Index Cache
.clangd/
compile_commands.json

# IDE & Editor Local Files (Keep settings.json & tasks.json, ignore user caches)
.vscode/*.log
.vscode/.ropeproject
.idea/
*.sublime-project
*.sublime-workspace

# Temporary, Scratch & Local Reference Artifacts
scratch/
**/scratch/
waveshare_ref/
waveshare_v2_ref/
*.tmp
*.bak
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
