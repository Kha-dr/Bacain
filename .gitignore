# ==============================================================================
# Git Ignore Rules for Mini-E-Reader (ESP-IDF + PWA + Python)
# ==============================================================================

# ESP-IDF Build & Output Directories
**/build/
**/sdkconfig
**/sdkconfig.old
**/dependencies.lock
**/managed_components/

# Python Cache & Virtual Environments
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Node.js & Web PWA Dependencies
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Language Server & Clangd Index Cache
.clangd/
compile_commands.json

# IDE & Editor Local Files (Keep settings.json & tasks.json, ignore user caches)
.vscode/*.log
.vscode/.ropeproject
.idea/
*.sublime-project
*.sublime-workspace

# Temporary, Scratch & Local Test Artifacts
**/scratch/
waveshare_ref/
waveshare_v2_ref/
*.tmp
*.bak
*.swp
*~

# Operating System Garbage
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
